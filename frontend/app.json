{
  "expo": {
    "name": "Tweed Dent Repairs",
    "slug": "tweed-dent-repairs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tweeddentrepairs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tweeddentrepairs.workflow",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of vehicle damage for job records",
        "NSPhotoLibraryUsageDescription": "Select damage photos from your gallery"
      }
    },
    "android": {
      "package": "com.tweeddentrepairs.workflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3B82F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tweed Dent Repairs to access your photos for damage documentation",
          "cameraPermission": "Allow Tweed Dent Repairs to use your camera for damage photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
